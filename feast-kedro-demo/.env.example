# Copy to `.env` and `set -a; source .env` (or export manually) before running.

# GCP project that owns the BigQuery dataset/table (offline store).
GCP_PROJECT=your-gcp-project

# BigQuery dataset that holds the feature tables (must already exist).
BQ_DATASET=feast

# Database connection details for the Postgres online store
POSTGRES_HOST=postgres
DB_USER=feast
DB_PASSWORD=feast
