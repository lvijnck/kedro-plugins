# Copy to `.env` and `set -a; source .env` (or export manually) before running.

# GCP project that owns the BigQuery dataset/table (offline store).
GCP_PROJECT=your-gcp-project

# BigQuery dataset that holds the driver_stats table (must already exist).
BQ_DATASET=feast_kedro_demo

# Postgres online store. Use `localhost` for local runs; docker-compose
# overrides this to the `postgres` service name for its containers.
POSTGRES_HOST=localhost
DB_USER=feast
DB_PASSWORD=feast
